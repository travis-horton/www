{
  "name": "www",
  "version": "3.30.1",
  "description": "website with parcel",
  "scripts": {
    "test": "jest",
    "build": "parcel build ./src/index.html",
    "serve": "parcel serve ./src/index.html",
    "rebuild": "docker build -t www_web . && docker run --rm -p 8080:80 www_web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travis-horton/www.git"
  },
  "author": "kiddspazz (https://www.travish.com/)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/travis-horton/www/issues"
  },
  "homepage": "https://github.com/travis-horton/www#readme",
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.5",
    "@parcel/transformer-image": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "parcel": "^2.12.0",
    "prettier": "^3.9.9",
    "process": "^0.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^url:.+$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(png|jpg|jpeg|gif|svg|ico|webp|avif|pdf|woff|woff2|ttf|otf|eot)$": "<rootDir>/__mocks__/bareAssetMock.js",
      "^/src/(.+)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            "@babel/preset-env",
            "@babel/preset-react",
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/jest.polyfills.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "@parcel/transformer-js": {
    "inlineEnvironment": [
      "NODE_ENV",
      "APP_VERSION",
      "BUILD_DATE",
      "npm_package_version"
    ]
  }
}
